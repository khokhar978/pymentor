# PyMentor Environment Configuration
# Copy this file to .env and configure your secrets before starting the server.

# Secret key required to access /admin and modify platform configurations
# DO NOT leave this as default. Choose a strong, secret phrase.
ADMIN_SECRET=change-me-to-a-secure-random-token

# Google Gemini API Key for AI Mentoring evaluations
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Comma-separated list of additional CORS origins (defaults to localhost and loopback)
# ALLOWED_ORIGINS=https://lab.yourdomain.com,http://localhost:8000

# Automated Database Backup & Failover Sync (GitHub Private Repo / Peer Sync)
# 100% card-free, zero-cost backup and sync solution.
# GITHUB_BACKUP_REPO=username/pymentor-backups
# GITHUB_BACKUP_TOKEN=ghp_your_personal_access_token_here
# GITHUB_BACKUP_BRANCH=main

# Direct Peer Sync (Optional): When running PyMentor on a portable laptop,
# specify the URL of your primary host server to pull the freshest database directly.
# HOST_SERVER_URL=https://khokhar.in.net
